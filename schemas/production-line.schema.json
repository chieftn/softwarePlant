{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Line Definition",
  "description": "A versioned product and production-method definition, independent of plant binding and production BOMs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "product", "productionMethods"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Location of the JSON Schema used to validate this document."
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/text",
      "description": "Revision of this production-line definition, not the product release."
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "businessProblem", "outputs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "businessProblem": {
          "$ref": "#/$defs/text"
        },
        "outputs": {
          "$ref": "#/$defs/textList"
        }
      }
    },
    "productionMethods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guidance", "workers", "skills", "tools"],
      "properties": {
        "guidance": {
          "$ref": "#/$defs/textList"
        },
        "workers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/worker"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "occupation", "role", "skillRefs", "toolRefs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "occupation": {
          "enum": ["coder", "task-coordinator", "quality-assurance-reviewer"]
        },
        "specialization": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "skillRefs": {
          "$ref": "#/$defs/references"
        },
        "toolRefs": {
          "$ref": "#/$defs/references"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "instructions"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "instructions": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
