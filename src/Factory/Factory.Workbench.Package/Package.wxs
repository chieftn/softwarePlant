<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Factory Workbench (Development)" Manufacturer="Factory" Version="$(var.ProductVersion)"
           UpgradeCode="E309B183-F658-4D0B-A550-BDFD71404EA3" Scope="perMachine" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer Factory Workbench installer is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="MsiLogging" Value="voicewarmup" />
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="ExistingInstallFolder" Root="HKLM" Key="Software\Factory\WorkbenchInstaller"
                      Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="FactoryFolder" Name="Factory">
        <Directory Id="INSTALLFOLDER" Name="Workbench Setup" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="FactoryStartMenu" Name="Factory Workbench">
        <Component Id="SetupShortcut" Guid="*">
          <Shortcut Id="SetupStartMenu" Name="Factory Workbench Setup" Target="[#WorkbenchSetup]"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\Factory\WorkbenchInstaller" Name="InstallFolder"
                         Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\Factory\WorkbenchInstaller" Name="ProductCode"
                         Type="string" Value="[ProductCode]" />
          <RegistryValue Root="HKLM" Key="Software\Factory\WorkbenchInstaller" Name="LastMsiLogFile"
                         Type="string" Value="[MsiLogFileLocation]" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Workbench" Title="Factory Workbench" Level="1">
      <ComponentGroupRef Id="PublishedPayload" />
      <ComponentRef Id="SetupShortcut" />
    </Feature>
    <Binary Id="LifecycleHelper" SourceFile="$(var.HelperPath)" />
    <CustomAction Id="RollbackRuntime" BinaryRef="LifecycleHelper" Execute="rollback" Impersonate="no"
                  ExeCommand="msi-rollback --transaction &quot;[ProductCode]&quot;" Return="check" />
    <CustomAction Id="ValidateHelper" BinaryRef="LifecycleHelper" Execute="deferred" Impersonate="no"
                  ExeCommand="msi-validate-helper --ui &quot;[#LifecycleTool]&quot;" Return="check" />
    <CustomAction Id="ValidateRemovalHelper" BinaryRef="LifecycleHelper" Execute="deferred" Impersonate="no"
                  ExeCommand="msi-validate-helper --ui &quot;[#LifecycleTool]&quot;" Return="check" />
    <CustomAction Id="ApplyRuntime" BinaryRef="LifecycleHelper" Execute="deferred" Impersonate="no"
                  ExeCommand="msi-apply --transaction &quot;[ProductCode]&quot; --package &quot;[INSTALLFOLDER]payload&quot; --ui-level &quot;[UILevel]&quot;" Return="check" />
    <CustomAction Id="PrepareRuntimeRemoval" BinaryRef="LifecycleHelper" Execute="deferred" Impersonate="no"
                  ExeCommand="msi-prepare-uninstall --transaction &quot;[ProductCode]&quot;" Return="check" />
    <!-- Only the bounded retirement request uses QuietExec; service/file maintenance can exceed its default timeout. -->
    <CustomAction Id="SetRequestRuntimeRetirement" Property="RequestRuntimeRetirement"
                  Value="&quot;[#LifecycleTool]&quot; msi-retire --transaction &quot;[ProductCode]&quot;" />
    <CustomAction Id="RequestRuntimeRetirement" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CommitRuntime" BinaryRef="LifecycleHelper" Execute="commit" Impersonate="no"
                  ExeCommand="msi-commit --transaction &quot;[ProductCode]&quot;" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RollbackRuntime" After="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ValidateRemovalHelper" Before="PrepareRuntimeRemoval"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="SetRequestRuntimeRetirement" Before="ValidateRemovalHelper"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PrepareRuntimeRemoval" Before="RequestRuntimeRetirement"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RequestRuntimeRetirement" Before="RemoveFiles"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ValidateHelper" After="InstallFiles" Condition="NOT REMOVE ~= &quot;ALL&quot;" />
      <Custom Action="ApplyRuntime" After="ValidateHelper"
              Condition="NOT REMOVE ~= &quot;ALL&quot;" />
      <Custom Action="CommitRuntime" Before="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="DevelopmentNotice.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Software installation is one phase. Finish continues directly to sign-in, enrollment and service verification. Until those succeed, enrollment is incomplete." />
    <Property Id="WixShellExecTarget" Value="[#WorkbenchSetup]" />
    <CustomAction Id="LaunchSetup" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />
    <CustomAction Id="OfferRemovalDiagnostics" BinaryRef="LifecycleHelper" Execute="immediate" Impersonate="yes"
                  ExeCommand="msi-offer-diagnostics --ui &quot;[#WorkbenchSetup]&quot; --log &quot;[MsiLogFileLocation]&quot;" Return="check" />
    <CustomAction Id="ShowRemovalOutcome" BinaryRef="LifecycleHelper" Execute="immediate" Impersonate="yes"
                  ExeCommand="msi-removal-summary --transaction &quot;[ProductCode]&quot; --log &quot;[MsiLogFileLocation]&quot;" Return="check" />
    <InstallUISequence>
      <Show Dialog="FatalError" Before="ExecuteAction" Condition="0" />
      <Show Dialog="WorkbenchFailure" OnExit="error" />
      <Custom Action="OfferRemovalDiagnostics" Before="ExecuteAction"
              Condition="Installed AND REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 5" />
      <Custom Action="ShowRemovalOutcome" After="ExecuteAction"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 5" />
    </InstallUISequence>
    <UI>
      <Dialog Id="WorkbenchFailure" Width="370" Height="180" Title="[ProductName] diagnostics">
        <Control Id="Explanation" Type="Text" X="20" Y="20" Width="330" Height="35"
                 Text="Setup did not complete. Open the Windows Installer log for package, helper and rollback diagnostics." />
        <Control Id="LogPath" Type="Text" X="20" Y="60" Width="330" Height="55"
                 Text="[MsiLogFileLocation]" />
        <Control Id="OpenLog" Type="PushButton" X="20" Y="140" Width="110" Height="20" Text="Open MSI log">
          <Publish Property="WixShellExecTarget" Value="[MsiLogFileLocation]" Condition="MsiLogFileLocation" />
          <Publish Event="DoAction" Value="LaunchSetup" Condition="MsiLogFileLocation" />
        </Control>
        <Control Id="OpenSetupLogs" Type="PushButton" X="135" Y="140" Width="115" Height="20" Text="Open setup logs">
          <Publish Property="WixShellExecTarget" Value="[CommonAppDataFolder]Factory\Workbench\logs" />
          <Publish Event="DoAction" Value="LaunchSetup" />
        </Control>
        <Control Id="Close" Type="PushButton" X="265" Y="140" Width="85" Height="20"
                 Text="Close" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSetup" Order="1"
               Condition="NOT REMOVE ~= &quot;ALL&quot;" />
    </UI>
  </Package>
</Wix>
